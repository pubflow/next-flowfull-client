# Public client configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_BRIDGE_BASE_PATH=/bridge
NEXT_PUBLIC_AUTH_BASE_PATH=/auth
NEXT_PUBLIC_BRIDGE_SECRET=
# Alternative public name supported by the starter:
# NEXT_PUBLIC_BRIDGE_VALIDATION_SECRET=

# Branding
NEXT_PUBLIC_APP_NAME=Flowfull Client
NEXT_PUBLIC_APP_LOGO=
NEXT_PUBLIC_PRIMARY_COLOR=#006aff
NEXT_PUBLIC_SECONDARY_COLOR=#4a90e2
NEXT_PUBLIC_ACCENT_COLOR=#06b6d4

# UI defaults
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Authentication
NEXT_PUBLIC_LOGIN_REDIRECT_PATH=/login
NEXT_PUBLIC_PUBLIC_PATHS=/login,/register,/forgot-password,/reset-password,/
NEXT_PUBLIC_ENABLE_ACCOUNT_CREATION=true
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true
# Comma-separated social auth providers. Examples: google or google,github
# Backend must have the matching provider configured.
NEXT_PUBLIC_LOGIN_PROVIDERS=
# Optional override. Defaults to NEXT_PUBLIC_API_BASE_URL + NEXT_PUBLIC_AUTH_BASE_PATH + /social
NEXT_PUBLIC_SOCIAL_AUTH_BASE_URL=

# Pubflow behavior
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=true
NEXT_PUBLIC_SHOW_SESSION_ALERTS=true
NEXT_PUBLIC_ENABLE_PERSISTENT_CACHE=true

# Coding Agent / browser preview only. Pubflow injects this automatically in previews.
# Accepted values: true, 1, yes, on. Keep false or unset in production.
NEXT_PUBLIC_PREVIEW_MODE=false
# Alias injected by Pubflow's browser runtime.
NEXT_PUBLIC_PUBFLOW_WEB_PREVIEW=false
